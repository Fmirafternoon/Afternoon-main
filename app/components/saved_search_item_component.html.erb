<li id="saved_search_<%= saved_search.id %>" class="<%= container_classes %> p-4">
  <div class="flex items-center gap-x-4 w-full ">
    <div class="flex items-start gap-x-2 self-start">
      <%= render DropdownComponent.new(position: :left) do |dropdown| %>
        <%= dropdown.with_trigger(classes: "cursor-pointer p-1 rounded-md #{active ? 'hover:bg-black-100' : 'hover:bg-gray-100'} transition-colors") do %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-500">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z" />
          </svg>
        <% end %>
        <%= dropdown.with_body do %>
          <%= link_to toggle_alerts_customer_saved_search_path(saved_search),
                      data: {
                        turbo_method: :post
                      },
                      class: "link-dropdown" do %>
            <% if saved_search.email_alerts_enabled? %>

              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
              </svg>
              Désactiver les alertes
            <% else %>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="green" class="w-4 h-4 inline mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0M3.124 7.5A8.969 8.969 0 0 1 5.292 3m13.416 0a8.969 8.969 0 0 1 2.168 4.5" />
              </svg>
              Activer les alertes
            <% end %>
          <% end %>
          <%= link_to customer_saved_search_path(saved_search),
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "Êtes-vous sûr de vouloir supprimer cette recherche ?"
                      },
                      class: "link-dropdown-danger" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 inline mr-2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
            </svg>
            Supprimer
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%= link_to load_customer_saved_search_path(saved_search),
                data: {
                  turbo_method: :get,
                  turbo_frame: "_top"
                },
                class: "flex-1 flex items-center min-w-0 gap-x-4" do %>
      <div class="flex-1 min-w-0">
        <p class="flex items-center gap-x-2 text-sm font-semibold <%= active ? 'text-black-900' : 'text-gray-900' %>">
          <% if active %>
            <span class="relative flex size-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex size-2 rounded-full bg-green-500"></span>
            </span>
          <% end %>
          <%= saved_search.name %>
          <% if saved_search.email_alerts_enabled? %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="green" class="w-4 h-4 inline mr-2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0M3.124 7.5A8.969 8.969 0 0 1 5.292 3m13.416 0a8.969 8.969 0 0 1 2.168 4.5" />
            </svg>
          <% end %>
        </p>
        <% if saved_search.formatted_criteria.present? %>
          <p class="mt-1 text-sm <%= active ? 'text-black-700' : 'text-gray-500' %> truncate">
            <%= saved_search.formatted_criteria %>
          </p>
        <% end %>
      </div>
    <% end %>

    <svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5 flex-none text-gray-400">
      <path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
    </svg>
  </div>
</li>