<div data-controller="turbo-modal" data-action="click->turbo-modal#backdrop" data-action="turbo:submit-end->turbo-modal#submit" class="hidden relative z-[1300]" aria-labelledby="modal-title" role="dialog" aria-modal="true">
  <!--
    Background backdrop, show/hide based on modal state.

    Entering: "ease-out duration-300"
      From: "opacity-0"
      To: "opacity-100"
    Leaving: "ease-in duration-200"
      From: "opacity-100"
      To: "opacity-0"
  -->
  <div class="fixed inset-0 bg-zinc-500/75 transition-opacity"></div>
    <div class="fixed inset-0 z-[1200] overflow-y-auto">
      <div data-turbo-modal-target="backdrop" class="flex min-h-screen items-center justify-center p-2">
        <!--
          Modal panel, show/hide based on modal state.

          Entering: "ease-out duration-300"
            From: "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
            To: "opacity-100 translate-y-0 sm:scale-100"
          Leaving: "ease-in duration-200"
            From: "opacity-100 translate-y-0 sm:scale-100"
            To: "opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
        -->
        <div class="relative transform overflow-hidden transition-all rounded-xl shadow-xl">
          <%= turbo_frame_tag "modal", data: { 'turbo-modal-target': 'content' } do %>
            <%= content %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>