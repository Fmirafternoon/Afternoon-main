<div class="<%= css_classes %>">
  <img src="<%= @image_url %>"
      class="w-full h-full object-cover"
      alt="<%= @title %>" />

  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent transition-transform duration-300 group-hover:scale-[2] scale-[2] md:scale-[1] group-hover:from-black/90 origin-bottom"></div>

  <!-- Content -->
  <div class="absolute inset-0 flex flex-col justify-center items-center p-4 text-center">
    <% if with_action? %>
      <!-- Carte avec contenu statique et hover -->
      <div class="flex flex-col items-center justify-end w-full h-full">
        <!-- État normal (titre seul) -->
        <div class="pb-14">
          <h3 class="text-white text-5xl font-bold transition-all duration-300 group-hover:opacity-0 opacity-0 md:opacity-100 group-hover:-translate-y-4"><%= @title %></h3>
        </div>

        <!-- État hover (texte complet) -->
        <div class="absolute inset-0 group-hover:opacity-100 opacity-100 md:opacity-0 translate-y-0 md:-translate-y-4 group-hover:translate-y-0 transition-all duration-300 flex flex-col justify-center items-center">
          <p class="text-white text-xl font-semibold text-center mb-4">
            Recruter <br> un collaborateur dans le
          </p>
          <h3 class="text-white text-5xl font-bold mb-8"><%= @title %></h3>
          <a href="<%= @button_link %>" target="_blank" class="hide-link-icon bg-primary text-black font-bold py-2 px-6 rounded-lg">
            <%= @button_text %>
          </a>
        </div>
      </div>
    <% else %>
      <!-- Carte sans action (affiche seulement le titre) -->
      <div class="flex flex-col items-end w-full h-full">
        <h3 class="text-white text-5xl font-bold"><%= @title %></h3>
      </div>
    <% end %>
  </div>
</div>
