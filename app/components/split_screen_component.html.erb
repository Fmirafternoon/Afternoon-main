<div class="flex min-h-full">
  <div class="relative hidden w-0 flex-1 max-w-md lg:block">
    <%= image_tag image, class: "absolute inset-0 size-full object-cover object-center" %>
  </div>
  <div class="flex grow flex-col justify-start p-6 lg:p-15 ">
    <div class="w-full grow flex flex-col">
      <%= content %>
    </div>
  </div>
</div>
