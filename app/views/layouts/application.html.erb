<!DOCTYPE html>
<html>
  <head>
    <%= render "head" %>

    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </head>

  <body class="antialiased">
    <%= render "impersonation" %>
    <main>
      <%= render 'notifications', notice: notice, alert: alert %>
      <%= render "navigation" %>
      <%= yield %>
    </main>
  </body>
</html>
