<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 12px;
      line-height: 1.4;
      color: #1f2937;
    }
    .pdf-page {
      width: 100%;
      background: white;
    }
    .pdf-header {
      background: #1f2937;
      color: white;
      padding: 20px 28px;
      display: table;
      width: 100%;
    }
    .pdf-logo {
      display: table-cell;
      vertical-align: middle;
      font-weight: 800;
      font-size: 18px;
    }
    .pdf-meta {
      display: table-cell;
      vertical-align: middle;
      font-size: 10px;
      color: #9ca3af;
      text-align: right;
    }
    .pdf-body {
      padding: 28px;
    }
    .pdf-candidate-header {
      display: table;
      width: 100%;
      margin-bottom: 20px;
    }
    .pdf-avatar {
      display: table-cell;
      vertical-align: top;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: #e5e7eb;
      text-align: center;
      line-height: 56px;
      font-weight: 800;
      font-size: 18px;
      color: #6b7280;
    }
    .pdf-candidate-info {
      display: table-cell;
      vertical-align: top;
      padding-left: 16px;
    }
    .pdf-title {
      font-size: 20px;
      font-weight: 800;
      color: #111827;
      margin-bottom: 4px;
    }
    .pdf-subtitle {
      font-size: 13px;
      color: #6b7280;
    }
    .pdf-summary {
      background: #f3f4f6;
      padding: 12px 16px;
      border-radius: 6px;
      font-size: 13px;
      line-height: 1.6;
      color: #374151;
      margin-bottom: 20px;
    }
    .pdf-grid {
      display: table;
      width: 100%;
      margin-bottom: 20px;
    }
    .pdf-grid-col {
      display: table-cell;
      width: 50%;
      vertical-align: top;
      padding-right: 16px;
    }
    .pdf-grid-col:last-child {
      padding-right: 0;
      padding-left: 16px;
    }
    .pdf-section {
      margin-bottom: 20px;
    }
    .pdf-section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #6b7280;
      border-bottom: 2px solid #e5e7eb;
      padding-bottom: 6px;
      margin-bottom: 10px;
    }
    .pdf-field {
      margin-bottom: 10px;
    }
    .pdf-field-label {
      font-size: 10px;
      font-weight: 600;
      color: #6b7280;
      margin-bottom: 2px;
    }
    .pdf-field-value {
      font-size: 13px;
      color: #1f2937;
    }
    .pdf-highlight-box {
      background: #f9fafb;
      padding: 10px 14px;
      margin-bottom: 10px;
    }
    .pdf-highlight-box.success {
      background: #f0fdf4;
    }
    .pdf-highlight-box.warning {
      background: #fef3c7;
    }
    .pdf-highlight-title {
      font-size: 11px;
      font-weight: 700;
      color: #374151;
      margin-bottom: 4px;
    }
    .pdf-highlight-text {
      font-size: 12px;
      color: #4b5563;
      line-height: 1.5;
    }
    .pdf-skill-tag {
      display: inline-block;
      background: #e5e7eb;
      color: #374151;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      margin: 2px 4px 2px 0;
    }
    .pdf-timeline {
      position: relative;
      padding-left: 16px;
    }
    .pdf-timeline-item {
      position: relative;
      margin-bottom: 14px;
      padding-left: 12px;
      border-left: 2px solid #e5e7eb;
    }
    .pdf-timeline-period {
      font-size: 10px;
      color: #6b7280;
    }
    .pdf-timeline-title {
      font-size: 13px;
      font-weight: 700;
      color: #1f2937;
    }
    .pdf-timeline-company {
      font-size: 12px;
      color: #4b5563;
    }
    .pdf-timeline-desc {
      font-size: 11px;
      color: #6b7280;
      margin-top: 2px;
    }
    .pdf-footer {
      background: #f3f4f6;
      padding: 14px 28px;
      font-size: 9px;
      color: #6b7280;
      text-align: center;
      border-top: 1px solid #e5e7eb;
    }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
