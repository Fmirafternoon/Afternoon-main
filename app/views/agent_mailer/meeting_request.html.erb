<h2 style="margin: 0 0 20px; color: #092E46; font-size: 20px; font-weight: 600;">
  Nouvelle demande de rendez-vous
</h2>

<p style="margin: 0 0 16px; color: #333; font-size: 14px; line-height: 1.5;">
  Bonjour <%= @agent.first_name %>,
</p>

<p style="margin: 0 0 20px; color: #333; font-size: 14px; line-height: 1.5;">
  Un client souhaite vous rencontrer pour discuter des candidats suivants :
</p>

<!-- Contact client -->
<div style="background-color: #d4edda; padding: 16px; border-radius: 8px; margin: 20px 0;">
  <p style="margin: 0 0 8px; color: #155724; font-weight: 600; font-size: 14px;">
    Contact client
  </p>
  <p style="margin: 0 0 4px; color: #333; font-size: 14px;">
    <strong><%= @customer.first_name %> <%= @customer.last_name %></strong>
  </p>
  <p style="margin: 0 0 4px; color: #333; font-size: 14px;">
    <%= mail_to @customer.email, @customer.email, style: "color: #155724;" %>
  </p>
  <% if @customer.phone_number.present? %>
    <p style="margin: 0; color: #333; font-size: 14px;">
      <%= @customer.phone_number %>
    </p>
  <% end %>
</div>

<p style="margin: 16px 0 8px; padding: 12px; background-color: #f8f9fa; border-radius: 6px; color: #333; font-size: 13px;">
  <strong>Astuce :</strong> Vous pouvez répondre directement à cet email pour échanger avec <%= @customer.first_name %>.
</p>

<!-- Détails du RDV -->
<div style="background-color: #f5f5f5; padding: 16px; border-radius: 8px; margin: 20px 0;">
  <p style="margin: 0 0 12px; color: #092E46; font-weight: 600; font-size: 14px;">
    Détails du rendez-vous
  </p>
  <p style="margin: 0 0 8px; color: #333; font-size: 14px;">
    <strong>Date proposée :</strong> <%= l(@basket_item.meeting_date, format: :long_with_time) %>
  </p>
  <p style="margin: 12px 0 4px; color: #333; font-size: 14px;">
    <strong>Candidats (<%= @candidates.count %>) :</strong>
  </p>
  <ul style="margin: 8px 0; padding-left: 20px;">
    <% @candidates.each do |candidate| %>
      <li style="margin: 4px 0; color: #333; font-size: 14px;">
        <%= link_to "#{candidate.first_name} #{candidate.last_name}", agent_candidate_url(candidate), style: "color: #092E46;" %> - <%= candidate.position %>
      </li>
    <% end %>
  </ul>
  <% if @basket_item.customer_message.present? %>
    <p style="margin: 12px 0 4px; color: #333; font-size: 14px;">
      <strong>Message :</strong>
    </p>
    <p style="margin: 4px 0; font-style: italic; color: #666; font-size: 14px;">
      <%= simple_format(@basket_item.customer_message) %>
    </p>
  <% end %>
</div>

<!-- Calendrier -->
<p style="margin: 24px 0 12px; color: #092E46; font-weight: 600; font-size: 14px;">
  Ajouter à mon calendrier :
</p>

<table width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center" style="padding: 8px;">
      <a href="<%= google_calendar_url(@basket_item) %>"
         style="display: inline-block; background-color: #4285f4; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-size: 13px;">
        Google Calendar
      </a>
    </td>
    <td align="center" style="padding: 8px;">
      <a href="<%= outlook_calendar_url(@basket_item) %>"
         style="display: inline-block; background-color: #0078d4; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-size: 13px;">
        Outlook
      </a>
    </td>
    <td align="center" style="padding: 8px;">
      <a href="<%= customer_basket_calendar_url(@basket_item) %>"
         style="display: inline-block; background-color: #666; color: white; padding: 10px 20px; text-decoration: none; border-radius: 6px; font-size: 13px;">
        Télécharger .ics
      </a>
    </td>
  </tr>
</table>

<p style="margin: 16px 0 0; color: #999; font-size: 12px;">
  Un fichier .ics est également joint à cet email.
</p>
