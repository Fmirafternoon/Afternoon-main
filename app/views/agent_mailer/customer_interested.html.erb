<!-- Header vert -->
<div style="background-color: #d4edda; padding: 16px; border-radius: 8px; margin: 0 0 24px; text-align: center;">
  <p style="margin: 0; color: #155724; font-size: 18px; font-weight: 600;">
    Client intéressé !
  </p>
</div>

<p style="margin: 0 0 16px; color: #333; font-size: 14px; line-height: 1.5;">
  Le client <strong><%= @customer.full_name %></strong> est intéressé par le candidat
  <strong><%= @candidate.full_name %></strong> pour le projet "<%= @project.title %>".
</p>

<% if @project_candidate.interest_message.present? %>
  <div style="background-color: #f8f9fa; border-left: 4px solid #28a745; padding: 12px 16px; margin: 16px 0;">
    <p style="margin: 0 0 4px; color: #666; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
      Message du client
    </p>
    <p style="margin: 0; color: #333; font-size: 14px; font-style: italic;">
      "<%= @project_candidate.interest_message %>"
    </p>
  </div>
<% end %>

<!-- Coordonnées client -->
<div style="background-color: #E5E500; padding: 16px; border-radius: 8px; margin: 24px 0;">
  <p style="margin: 0 0 8px; color: #333; font-size: 14px; font-weight: 600;">
    Coordonnées du client
  </p>
  <p style="margin: 0 0 4px; color: #333; font-size: 14px;">
    <strong><%= @customer.full_name %></strong>
  </p>
  <p style="margin: 0 0 4px; color: #333; font-size: 14px;">
    <%= mail_to @customer.email, @customer.email, style: "color: #333;" %>
  </p>
  <% if @customer.phone_number.present? %>
    <p style="margin: 0; color: #333; font-size: 14px;">
      <%= @customer.phone_number %>
    </p>
  <% end %>
</div>

<!-- Candidat -->
<div style="background-color: #e8e8e8; padding: 16px; border-radius: 8px; margin: 16px 0;">
  <p style="margin: 0 0 8px; color: #333; font-size: 14px; font-weight: 600;">
    Candidat : <%= @candidate.full_name %>
  </p>
  <p style="margin: 0; color: #666; font-size: 13px;">
    <%= @candidate.position %> - <%= @candidate.total_experience_in_years %> ans d'expérience
  </p>
</div>

<table width="100%" cellpadding="0" cellspacing="0" style="margin-top: 24px;">
  <tr>
    <td align="center">
      <a href="<%= agent_project_candidate_url(@project, @project_candidate) %>"
         style="display: inline-block; background-color: #E5E500; color: #092E46; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px;">
        Voir le détail
      </a>
    </td>
  </tr>
</table>
