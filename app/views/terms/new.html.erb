<div data-controller="terms-scroll" class="h-full flex flex-col max-w-3xl mx-auto p-4">
  <div class="flex justify-center mb-4">
    <%= render LogoComponent.new(size: :xl) %>
  </div>

  <div data-terms-scroll-target="container" data-action="scroll->terms-scroll#scroll" class="overflow-y-scroll border border-gray-200 grow prose prose-sm  max-w-none p-2">
    <%= @terms_html.html_safe %>
  </div>

  <div class="py-4 flex justify-end">
    <%= simple_form_for :terms, url: terms_path do |f| %>
      <%=
        f.submit "Accepter les CGV",
          class: "button-primary button-lg",
          disabled: true,
          data: { terms_scroll_target: "submit" }
      %>
    <% end %>
  </div>
</div>