<%= simple_form_for @form, url: agent_candidate_wizard_path(@candidate, step), as: :wizard_form, method: :put do |f| %>

  <%= render Form::NavbarComponent.new(
    title: "Construire le profil du candidat",
    cancel_path: agent_candidate_path(@candidate),
    current_step: step,
    previous_path: previous_wizard_path,
    wizard_steps: wizard_steps,
    show_finish: true
  ) %>

  <%= render Form::StepComponent.new(
    wizard: :candidate,
    wizard_steps: wizard_steps,
    current_step: step,
    previous_path: previous_wizard_path,
    show_finish: true
  ) do |step_component| %>
    <% step_component.with_breadcrumb(
      wizard: :candidate,
      wizard_steps: wizard_steps,
      current_step: step,
      description: "Vérifiez et complétez les informations du candidat. Seul les profils 100% complétés seront proposés.",
      step_path: ->(step) { step_path(step) },
      step_accessible: ->(step) { step_accessible?(step) }
    ) %>

      <!-- Start content -->
      <div class="col-span-2">
        <%= f.input :position %>
      </div>

      <div>
        <%= f.input :total_experience_in_years, hint: "Indiquer uniquement les années d'expérience en lien avec le poste recherché" %>
      </div>
      <div></div>

      <div class="col-span-2 mt-2">
        <%=
          f.input :description,
            as: :text,
            input_html: {
              rows: 4,
              data: {
                controller: 'character-counter autogrow',
                'character-counter-max-value': 500
              }
            },
            label: "Résumé du profil/pitch",
            hint: "500 caractères maximum",
            wrapper_html: { class: "grow-wrap" }
        %>
      </div>

      <div class="col-span-2 mt-2">
        <%= f.input :ongoing_application, as: :switch, label: "Candidature en cours", hint: "Activer si le candidat a déjà une candidature en cours" %>
      </div>

      <div class="col-span-2 mt-2">
        <%=
          f.input :change_motivations,
            as: :text,
            label: "Motivations au changement de poste",
            hint: "500 caractères maximum",
            wrapper_html: {
              class: "grow-wrap"
            },
            input_html: {
              rows: 4,
              data: {
                controller: 'autogrow character-counter',
                'character-counter-max-value': 500
              }
            }
           %>
      </div>

      <div class="col-span-2 mt-2">
        <%= f.input :career_relevance, as: :text, input_html: { rows: 4, data: { controller: 'autogrow character-counter', 'character-counter-max-value': 500 } }, label: "Cohérence du parcours professionnel", hint: "500 caractères maximum" %>
      </div>
      <!-- End content -->


  <% end %>
<% end %>
