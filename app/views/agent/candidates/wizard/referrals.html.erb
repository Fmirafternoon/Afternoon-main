<%= simple_form_for @form, url: agent_candidate_wizard_path(@candidate, step), as: :wizard_form, method: :put do |f| %>

  <%= render Form::NavbarComponent.new(
    title: "Construire le profil du candidat",
    cancel_path: agent_candidate_path(@candidate),
    current_step: step,
    previous_path: previous_wizard_path,
    wizard_steps: wizard_steps,
    show_finish: true
  ) %>

  <%= render Form::StepComponent.new(
    wizard: :candidate,
    wizard_steps: wizard_steps,
    current_step: step,
    previous_path: previous_wizard_path,
    show_finish: true
  ) do |step_component| %>
    <% step_component.with_breadcrumb(
      wizard: :candidate,
      wizard_steps: wizard_steps,
      current_step: step,
      description: "Vérifiez et complétez les informations du candidat. Seul les profils 100% complétés seront proposés.",
      step_path: ->(step) { step_path(step) },
      step_accessible: ->(step) { step_accessible?(step) }
    ) %>


      <%= f.input :last_name %>
      <%= f.input :first_name %>
      <%= f.input :phone_number %>
      <%= f.input :email %>
      <%= f.input :company %>
      <%= f.input :position %>
      <div class="col-span-2">
        <%= f.input :description, as: :text, input_html: { data: { controller: "autogrow" } } %>
      </div>
      <div class="col-span-2">
        <%= button_tag "Ajouter référence", type: "submit", name: "commit", value: "add_referral", class: "w-full button-ghost button-xl" %>
      </div>


      <div class="col-span-2 mt-6">
        <h3 class="title-5 text-mute-800 mb-2">Références</h3>
        <% if @candidate.referrals.any? %>
          <div class="flex flex-col gap-4">
          <% @candidate.referrals.each do |referral| %>
            <div class="flex justify-between items-start bg-gray-100 rounded-xl px-6 py-4">
              <div class="mr-1">
                <div class="paragraph-sm text-mute-800">
                  <%= referral.first_name %>
                  <%= referral.last_name %>
                </div>
                <h3 class="label-sm"><%= referral.company %></h3>
                <p class="paragraph-sm">
                  <%= referral.position %>
                </p>
                <p class="paragraph-sm">
                  <%= referral.description %>
                </p>

              </div>
              <%= link_to "&times;".html_safe,
                  agent_candidate_referral_path(referral),
                  data: { turbo_method: :delete, turbo_confirm: "Êtes-vous sûr de vouloir supprimer cette référence ?" },
                  class: "text-red-500 text-xl" %>
            </div>
          <% end %>
        <% else %>
          <p class="text-gray-500">Aucune référence ajoutée pour le moment.</p>
        <% end %>
      </div>
  <% end %>
<% end %>
