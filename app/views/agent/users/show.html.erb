<%= render HeaderComponent.new(title: @user.full_name) do |header| %>
  <%= header.with_body do %>
    <%= render Role::BadgeComponent.new(role: @user.role) %>
  <% end %>
  <%= header.with_actions do %>
    <div class="flex gap-x-2">
      <%= link_to agent_users_path, class: "button-white" do %>
        <%= inline_svg_tag('icons/chevron-left.svg', class: "w-4") %>
        Retour à la liste
      <% end %>
      <%= link_to "Modifier", edit_agent_user_path(@user), class: "button-white" %>

      <%= render DropdownComponent.new do |dropdown| %>
        <%= dropdown.with_trigger(classes: "button-white") do %>
          <%= inline_svg_tag "icons/ellipsis-vertical.svg", class: "w-4" %>
        <% end %>
        <%= dropdown.with_body do %>
          <%= link_to "Inviter", invite_agent_user_path(@user), data: { turbo_method: :post }, class: "link-dropdown" %>
                    <%= dropdown.with_separator %>
          <%= link_to "Supprimer", agent_user_path(@user), data: { turbo_method: :delete, turbo_confirm: "Êtes-vous sûr de vouloir supprimer cet utilisateur ?" }, class: "link-dropdown text-danger" %>
        <% end %>
      <% end %>

    </div>
  <% end %>
<% end %>


<%= render Card::ContainerComponent.new do |container| %>
  <div class="xl:w-[70%]">
    <%=
      container.with_title(
        title: "Informations de l'utilisateur"
      )
    %>
    <%= container.with_card do |card| %>
      <%= card.with_body do %>
        <%= card.with_item(label: "Email", value: @user.email) %>

        <%= card.with_item(label: "Invitation envoyée le", value: l(@user.invitation_sent_at, default: nil)) %>
        <%= card.with_item(label: "Mot de passe créé le", value: l(@user.password_set_at, default: nil)) %>
      <% end %>
    <% end %>
  </div>
<% end %>
