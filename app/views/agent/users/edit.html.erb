<%= render HeaderComponent.new(title: "Modifier #{@user.full_name}") do |header| %>
  <%= header.with_actions do %>
    <div class="flex gap-x-2">
      <%= link_to agent_users_path, class: "button-white" do %>
        <%= inline_svg_tag('icons/chevron-left.svg', class: "w-4") %>
        Retour à la liste
      <% end %>
      <% if policy(:user).edit? %>
        <%= link_to "Modifier", edit_agent_user_path(@user), class: "button-white" %>
      <% end %>
    </div>
  <% end %>
<% end %>


<%= render "form", user: @user, url: agent_user_path(@user) %>
