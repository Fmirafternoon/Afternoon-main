<%= render SplitScreenComponent.new(image: image_path("header.webp")) do %>

  <div class="mb-12">
    <%= render LogoComponent.new %>
  </div>

  <div class="grow flex flex-col justify-center mx-auto max-w-sm">
    <h2 class="title-3">
      Accédez à votre espace
    </h2>
    <p class="mb-8 paragraph-md text-gray-500">
      Recherchez des collaborateurs, partagez les profils de vos candidats.
    </p>

    <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= f.input :email,
                  required: false,
                  autofocus: true,
                  input_html: { autocomplete: "email" } %>
      <%= f.input :password,
                  required: false,
                  input_html: { autocomplete: "current-password" } %>
      <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>

      <%= f.button :submit, "Me connecter", class: "button-primary button-lg w-full" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
<% end %>