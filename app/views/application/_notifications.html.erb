<div id="notifications" class="z-50 p-8 fixed right-0 bottom-0 flex flex-col space-y-4 overflow-hidden">
  <% if notice %>
    <%= render Notification::NoticeComponent.new(message: notice) %>
  <% end %>
  <% if alert %>
    <%= render Notification::AlertComponent.new(message: alert) %>
  <% end %>
</div>