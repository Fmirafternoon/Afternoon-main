<% if respond_to?(:resource) && resource.is_a?(User) && resource.persisted? && policy(resource).impersonate? %>
  <%= link_to impersonate_admin_user_path(resource),
              method: :post,
              class: "inline-flex items-center px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg transition-colors duration-200" do %>
    <span class="mr-2">👻</span>
    <span>Impersonate</span>
  <% end %>
<% end %>
