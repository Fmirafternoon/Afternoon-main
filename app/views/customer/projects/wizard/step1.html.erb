<% if new_project? %>
  <% form_url = customer_project_wizard_index_path("new") %>
  <% form_method = :post %>
<% else %>
  <% form_url = customer_project_wizard_path(@project, step) %>
  <% form_method = :put %>
<% end %>
<%= simple_form_for @form, url: form_url, as: :wizard_form, method: form_method do |f| %>
  <div class="container mx-auto px-4 py-8" style="max-width:600px">
    <div class="mb-4">
      <div class="flex justify-between text-sm mb-2">
        <span class="font-bold">Étape 1/3</span>
        <span class="text-gray-500">Définir le poste</span>
      </div>
      <div class="bg-gray-200 rounded-full h-2">
        <div class="bg-primary h-2 rounded-full" style="width:33%"></div>
      </div>
    </div>

    <h1 class="title-2 mb-2">Décrivez le poste recherché</h1>
    <p class="text-gray-500 mb-6">Ces informations nous aident à trouver les meilleurs candidats.</p>

    <div class="card p-6">
      <div class="mb-4">
        <%= f.input :position_name, label: "Intitulé du poste", placeholder: "Ex: Chef de cuisine" %>
      </div>

      <div class="grid grid-cols-2 gap-4 mb-4">
        <div>
          <%= f.input :location_city, label: "Lieu", placeholder: "Ex: Paris 8e" %>
        </div>
        <div>
          <%= f.input :start_date, as: :string, label: "Date de début", input_html: { type: "date" } %>
        </div>
      </div>

      <div class="mb-4">
        <div class="">
          <label class="label mb-0 block mb-2">Type de contrat <span class="text-red-500">*</span></label>
          <div class="button-group" data-controller="radio-buttons">
            <% [["CDI", "cdi"], ["CDD", "cdd"], ["Intérim", "interim"]].each do |label, value| %>
              <label class="<%= @form.contract_type == value ? 'active' : '' %>" data-radio-buttons-target="label" data-action="click->radio-buttons#select">
                <%= f.radio_button :contract_type, value, class: "hidden", data: { radio_buttons_target: "input" } %>
                <%= label %>
              </label>
            <% end %>
          </div>
        </div>
        <% if @form.errors[:contract_type].any? %>
          <span class="error text-red-600 text-sm"><%= @form.errors[:contract_type].first %></span>
        <% end %>
      </div>

      <div>
        <%= f.input :description, as: :text, label: "Description du poste", placeholder: "Décrivez les responsabilités...", input_html: { rows: 3 } %>
      </div>
    </div>

    <div class="flex justify-between mt-6">
      <%= link_to "Annuler", customer_projects_path, class: "button-secondary" %>
      <%= f.submit "Continuer →", class: "button-primary" %>
    </div>
  </div>
<% end %>
