<turbo-frame id="modal">
  <div class="modal-content max-w-lg mx-auto bg-white rounded-2xl p-6">
    <h2 class="title-3 mb-4">Exprimer votre intérêt</h2>

    <p class="paragraph-sm text-mute-700 mb-6">
      Vous souhaitez en savoir plus sur le <strong>Candidat <%= @project_candidate.anonymized_number %></strong> ?
      Le cabinet sera notifié et vous recontactera rapidement.
    </p>

    <%= form_with url: interest_customer_project_candidate_path(@project, @project_candidate),
                  method: :post,
                  data: { turbo: true },
                  class: "space-y-4" do |f| %>

      <div>
        <%= f.label :message, "Message (optionnel)", class: "block paragraph-sm font-semibold text-mute-900 mb-2" %>
        <%= f.text_area :message,
                        rows: 4,
                        placeholder: "Ex: Ce profil correspond à notre recherche. Je souhaite organiser un entretien...",
                        class: "w-full px-4 py-2 border border-mute-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
      </div>

      <div class="flex gap-3 justify-end mt-6">
        <%= link_to "Annuler", "#",
                    data: { action: "click->modal#close" },
                    class: "button-ghost button-md" %>
        <%= f.submit "Confirmer mon intérêt", class: "button-primary button-md" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
