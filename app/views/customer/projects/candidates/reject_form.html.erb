<turbo-frame id="modal">
  <div class="modal-content max-w-lg mx-auto bg-white rounded-2xl p-6">
    <h2 class="title-3 mb-4">Rejeter ce candidat</h2>

    <p class="paragraph-sm text-mute-700 mb-6">
      Vous ne souhaitez pas poursuivre avec le <strong>Candidat <%= @project_candidate.anonymized_number %></strong> ?
      Merci d'indiquer la raison pour aider le cabinet à affiner sa recherche.
    </p>

    <%= form_with url: reject_customer_project_candidate_path(@project, @project_candidate),
                  method: :post,
                  data: { turbo: true },
                  class: "space-y-4" do |f| %>

      <div>
        <%= f.label :reason, "Raison du rejet", class: "block paragraph-sm font-semibold text-mute-900 mb-2" %>
        <%= f.text_area :reason,
                        rows: 4,
                        required: true,
                        placeholder: "Ex: Le profil ne correspond pas à nos attentes en termes de...",
                        class: "w-full px-4 py-2 border border-mute-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" %>
        <p class="text-xs text-mute-600 mt-1">Ce champ est obligatoire.</p>
      </div>

      <div class="flex gap-3 justify-end mt-6">
        <%= link_to "Annuler", "#",
                    data: { action: "click->modal#close" },
                    class: "button-ghost button-md" %>
        <%= f.submit "Confirmer le rejet", class: "button-danger button-md" %>
      </div>
    <% end %>
  </div>
</turbo-frame>
