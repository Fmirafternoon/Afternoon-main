<div class="bg-white max-w-6xl pt-24 pb-30 mx-auto px-4">

  <div class="">
    <div class="flex flex-col mx-6 lg:mx-0 lg:flex-row gap-x-18">
      <div class="block">
        <%= inline_svg_tag "benefits.svg", class: "max-w-full mx-auto w-[360px]" %>
      </div>
      <div class="">
        <h5 class="title-5 text-mute-800">
          Issus des meilleurs cabinets de recrutement
        </h5>

        <h1 class="mt-3 mb-10 title-2">
          Le recrutement est un <span class="whitespace-nowrap">casse-tête</span>&nbsp;? <br>On le simplifie pour vous
        </h1>
        <ul class="mb-10 gap-y-6 flex flex-col">
          <li class="paragraph-md flex gap-x-2 items-start md:items-center">
            <%= inline_svg_tag "icons/check.svg", class: "mt-1 md:mt-0 shrink-0 w-4.5 h-4.5" %>
            Visualisez instantanément tous les candidats disponibles
          </li>
          <li class="paragraph-md flex gap-x-2 items-start md:items-center">
            <%= inline_svg_tag "icons/check.svg", class: "mt-1 md:mt-0 shrink-0 w-4.5 h-4.5" %>
            Nos candidats sont qualifiés par des recruteurs spécialisés
          </li>
          <li class="paragraph-md flex gap-x-2 items-start md:items-center">
            <%= inline_svg_tag "icons/check.svg", class: "mt-1 md:mt-0 shrink-0 w-4.5 h-4.5" %>
            Prenez rendez-vous directement sur le site
          </li>
        </ul>

        <%= link_to "Réserver une démo", ENV.fetch("CALENDLY_URL"), target: "_blank", class: "hide-link-icon button-primary button-md" %>

        <p class="mt-4 text-sm">
          Vous êtes recruteur ?
          <%= link_to "Contactez-nous", "mailto:contact@afternoon.team", class: "link" %>
        </p>
      </div>
    </div>

  </div>
</div>
