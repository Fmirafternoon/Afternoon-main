#!/usr/bin/env bash
set -uo pipefail

APP_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$APP_ROOT"

# ─── Couleurs ────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

PASS=0; FAIL=0; WARN=0

ok()   { echo -e "  ${GREEN}✓${NC} $1"; ((PASS++)); }
fail() { echo -e "  ${RED}✗${NC} ${BOLD}$1${NC}"; [[ -n "${2:-}" ]] && echo -e "    ${YELLOW}→${NC} $2"; ((FAIL++)); }
warn() { echo -e "  ${YELLOW}!${NC} $1"; ((WARN++)); }
h()    { echo -e "\n${BLUE}${BOLD}── $1${NC}"; }

OS=$(uname -s); ARCH=$(uname -m)
IS_MAC=false; IS_LINUX=false
[[ "$OS" == "Darwin" ]] && IS_MAC=true
[[ "$OS" == "Linux"  ]] && IS_LINUX=true
IS_ARM=false
[[ "$ARCH" == "arm64" || "$ARCH" == "aarch64" ]] && IS_ARM=true

echo ""
echo -e "${BOLD}Afternoon — Doctor${NC}"
echo "══════════════════════════════════════════════"

# ─── Ruby ─────────────────────────────────
h "Ruby"
REQUIRED_RUBY="3.4.2"
if command -v ruby &>/dev/null; then
  RUBY_VER=$(ruby -e "puts RUBY_VERSION" 2>/dev/null || ruby --version | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  if [[ "$RUBY_VER" == "$REQUIRED_RUBY" ]]; then
    ok "Ruby $RUBY_VER"
  else
    fail "Ruby $RUBY_VER (requis : $REQUIRED_RUBY)" \
         "rbenv install $REQUIRED_RUBY && rbenv global $REQUIRED_RUBY"
  fi
else
  fail "Ruby absent" "rbenv install $REQUIRED_RUBY"
fi

# ─── Gems ────────────────────────────────
h "Gems"
if command -v bundle &>/dev/null; then
  if bundle check &>/dev/null 2>&1; then
    ok "bundle check OK"
  else
    fail "Gems manquants" "bundle install"
  fi
else
  fail "Bundler absent" "gem install bundler"
fi

# ─── PostgreSQL ──────────────────────────
h "PostgreSQL"
PG_OK=false
if command -v psql &>/dev/null; then
  PG_VER=$(psql --version 2>&1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
  ok "PostgreSQL $PG_VER installé"

  if pg_isready &>/dev/null 2>&1; then
    ok "Service PostgreSQL actif"
    PG_OK=true

    VECTOR_AVAIL=$(psql -U "$USER" postgres -tc \
      "SELECT COUNT(*) FROM pg_available_extensions WHERE name='vector'" 2>/dev/null | tr -d ' ')
    if [[ "$VECTOR_AVAIL" == "1" ]]; then
      ok "Extension pgvector disponible"
    else
      $IS_MAC   && fail "pgvector non disponible" "brew install pgvector"
      $IS_LINUX && fail "pgvector non disponible" "sudo apt install postgresql-16-pgvector"
    fi
  else
    $IS_MAC   && fail "Service PostgreSQL inactif" "brew services start postgresql@16"
    $IS_LINUX && fail "Service PostgreSQL inactif" "sudo systemctl start postgresql"
  fi
else
  $IS_MAC   && fail "PostgreSQL absent" "brew install postgresql@16 pgvector && brew services start postgresql@16"
  $IS_LINUX && fail "PostgreSQL absent" "sudo apt install postgresql-16 postgresql-16-pgvector"
fi

# ─── Redis ────────────────────────────────
h "Redis"
if command -v redis-cli &>/dev/null; then
  ok "Redis installé"
  if redis-cli ping &>/dev/null 2>&1; then
    ok "Service Redis actif"
  else
    $IS_MAC   && fail "Redis inactif" "brew services start redis"
    $IS_LINUX && fail "Redis inactif" "sudo systemctl start redis-server"
  fi
else
  $IS_MAC   && fail "Redis absent" "brew install redis && brew services start redis"
  $IS_LINUX && fail "Redis absent" "sudo apt install redis-server && sudo systemctl start redis-server"
fi

# ─── ImageMagick ─────────────────────────
h "ImageMagick"
if command -v convert &>/dev/null; then
  IM_VER=$(convert --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  ok "ImageMagick $IM_VER"
else
  $IS_MAC   && fail "ImageMagick absent" "brew install imagemagick"
  $IS_LINUX && fail "ImageMagick absent" "sudo apt install imagemagick libmagickwand-dev"
fi

# ─── Tesseract ────────────────────────────
h "Tesseract (OCR)"
if command -v tesseract &>/dev/null; then
  TESS_VER=$(tesseract --version 2>&1 | head -1 | grep -oE '[0-9]+\.[0-9]+')
  ok "Tesseract $TESS_VER"

  if tesseract --list-langs 2>&1 | grep -q "^fra$"; then
    ok "Langue française (fra) présente"
  else
    $IS_MAC   && fail "Langue fra manquante" "brew install tesseract-lang"
    $IS_LINUX && fail "Langue fra manquante" "sudo apt install tesseract-ocr-fra"
  fi
else
  $IS_MAC   && fail "Tesseract absent" "brew install tesseract tesseract-lang"
  $IS_LINUX && fail "Tesseract absent" "sudo apt install tesseract-ocr tesseract-ocr-fra"
fi

# ─── wkhtmltopdf ─────────────────────────
h "wkhtmltopdf"
if $IS_MAC; then
  if command -v wkhtmltopdf &>/dev/null; then
    WK_PATH=$(which wkhtmltopdf)
    ok "wkhtmltopdf ($WK_PATH)"
    if $IS_ARM; then
      INIT="config/initializers/wicked_pdf.rb"
      if grep -q "/usr/local/bin/wkhtmltopdf" "$INIT" 2>/dev/null && \
         ! grep -q "which wkhtmltopdf\|opt/homebrew" "$INIT" 2>/dev/null; then
        warn "Apple Silicon : chemin hardcodé /usr/local/bin dans $INIT — PDF peut échouer"
      fi
    fi
  else
    fail "wkhtmltopdf absent (requis sur macOS)" "brew install wkhtmltopdf"
  fi
else
  ok "wkhtmltopdf — fourni par le gem wkhtmltopdf-heroku sur Linux (rien à installer)"
fi

# ─── Overmind ─────────────────────────────
h "Overmind"
if command -v overmind &>/dev/null; then
  ok "Overmind $(overmind --version 2>&1 | head -1)"
else
  $IS_MAC   && fail "Overmind absent" "brew install overmind"
  $IS_LINUX && fail "Overmind absent" \
    "curl -L https://github.com/DarthSim/overmind/releases/latest/download/overmind-linux-amd64.gz | gunzip | sudo tee /usr/local/bin/overmind > /dev/null && sudo chmod +x /usr/local/bin/overmind"
fi

# ─── .env ────────────────────────────────
h "Configuration (.env)"
ENV_FILE="$APP_ROOT/.env"
if [[ -f "$ENV_FILE" ]]; then
  ok ".env présent"
  REQUIRED_KEYS=(REDIS_URL DEEPSEEK_API_KEY CLOUDINARY_URL EMBEDDING_KEY EMBEDDING_MODEL_ID EMBEDDING_URL)
  for key in "${REQUIRED_KEYS[@]}"; do
    VALUE=$(grep "^${key}=" "$ENV_FILE" 2>/dev/null | cut -d= -f2- | tr -d '"' | tr -d "'")
    if [[ -n "$VALUE" ]]; then
      ok "$key défini"
    else
      fail "$key manquant ou vide" "Demander le .env complet à l'équipe"
    fi
  done
else
  fail ".env absent" "Demander le .env à l'équipe (pas de .env.example dans le repo)"
fi

# ─── Base de données ──────────────────────
h "Base de données"
if command -v ruby &>/dev/null && bundle check &>/dev/null 2>&1 && [[ -f "$ENV_FILE" ]]; then
  if bin/rails runner "ActiveRecord::Base.connection.execute('SELECT 1')" &>/dev/null 2>&1; then
    ok "Connexion DB OK"

    VEXT=$(bin/rails runner \
      "puts ActiveRecord::Base.connection.execute(\"SELECT COUNT(*) FROM pg_extension WHERE extname='vector'\").first.values.first" \
      2>/dev/null | tail -1)
    if [[ "$VEXT" == "1" ]]; then
      ok "Extension vector activée dans la DB"
    else
      fail "Extension vector non activée" "bin/rails db:prepare"
    fi

    PENDING=$(bin/rails db:migrate:status 2>/dev/null | grep -c "^\s*down" || true)
    if [[ "${PENDING:-0}" -eq 0 ]]; then
      ok "Migrations à jour"
    else
      fail "$PENDING migration(s) en attente" "bin/rails db:migrate"
    fi
  else
    fail "Connexion DB échouée" "bin/rails db:prepare"
  fi
else
  warn "Vérification DB ignorée (Ruby, gems ou .env manquants)"
fi

# ─── Résumé ───────────────────────────────
echo ""
echo "══════════════════════════════════════════════"
echo -e "${BOLD}Résultat : ${GREEN}$PASS OK${NC}  ${RED}$FAIL échec${NC}  ${YELLOW}$WARN avertissement${NC}"

if [[ $FAIL -gt 0 ]]; then
  echo -e "\n${RED}${BOLD}Corriger les erreurs ci-dessus avant de lancer le projet.${NC}"
  exit 1
else
  echo -e "\n${GREEN}${BOLD}Tout est OK — lance le projet avec : overmind start${NC}"
fi
